{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/refs/heads/main/cspell.schema.json",
  "allowCompoundWords": true,
  "dictionaries": ["bash", "companies", "filetypes", "git", "golang", "powershell", "salad-cloud-cli", "softwareTerms"],
  "dictionaryDefinitions": [
    { "name": "salad-cloud-cli", "path": "./dictionaries/salad-cloud-cli.txt", "addWords": true },
    { "name": "test-fixtures", "path": "./dictionaries/test-fixtures.txt", "addWords": true }
  ],
  "ignorePaths": [".git/**", ".gitattributes", ".gitignore", "go.mod", "go.sum", "package-lock.json", "**/testdata/**"],
  "language": "en,en-US",
  "languageSettings": [
    {
      "languageId": "go",
      "includeRegExpList": ["CStyleComment", "string"],
      "ignoreRegExpList": [
        "import\\s*\\((.|[\\r\\n])*?\\)",
        "import\\s*.*\".*?\"",
        "//\\s*go:generate.*",
        "//\\s*nolint:.*",
        "%[-+# 0-9.*]*[a-zA-Z]"
      ]
    }
  ],
  "overrides": [{ "filename": "**/*_test.go", "dictionaries": ["test-fixtures"] }],
  "useGitignore": true,
  "version": "0.2"
}
