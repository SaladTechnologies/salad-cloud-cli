root = true

[*]
charset = utf-8
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{bat,cmd}]
end_of_line = crlf
indent_size = 2
max_line_length = 120

[*.go]
end_of_line = lf
indent_style = tab
max_line_length = 120

[go.{mod,sum}]
end_of_line = lf
indent_style = tab

[*.json]
indent_size = 2
max_line_length = 120

[*.md]
indent_size = 2

[*.{ps1,psd1,psm1}]
end_of_line = lf
max_line_length = 120

[*.sh]
end_of_line = lf
indent_size = 2
max_line_length = 120

[[shell]]
end_of_line = lf
indent_size = 2
max_line_length = 120
simplify = true
switch_case_indent = true

[*.{yml,yaml}]
indent_size = 2
max_line_length = 120
