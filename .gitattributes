# Store text with LF line endings; check scripts out with the endings their
# interpreters need.
*           text=auto
*.go        text diff=golang
*.mod       text
*.sum       text
*.md        text
*.json      text
*.yml       text
*.yaml      text
*.sh        text eol=lf
*.ps1       text eol=lf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Build and release output, should any ever be committed.
*.exe       binary
*.gz        binary
*.zip       binary
*.png       binary
